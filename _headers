# Cloudflare Pages header rules. Not served as a file.

# Applies everywhere, including the apex, which /*.html would miss.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Brand assets change rarely, but not never.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=604800

# HTML keeps the Pages default of max-age=0, must-revalidate. The prefixes
# have not changed since 1998 and the practice has not changed since before
# that, but the drawing is revised more often than either.
